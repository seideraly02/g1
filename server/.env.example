PORT=3000
DATABASE_URL=jdbc:postgresql://localhost:5432/qadam_ent
DATABASE_USER=qadam
DATABASE_PASSWORD=qadam
DATABASE_POOL_SIZE=10
DATABASE_MIN_IDLE=2

# Comma-separated browser origins allowed to call the API directly.
FRONTEND_ORIGINS=http://localhost:4173

# Set to production in the deployed backend.
AUTH_MODE=development
DEVELOPMENT_OTP_CODE=111111
TRUSTED_PROXY_SECRET=
SECURITY_PEPPER=development-only-pepper-change-before-production
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=Lax
SESSION_TTL_DAYS=30

TELEGRAM_GATEWAY_URL=
TELEGRAM_GATEWAY_TOKEN=
SWAGGER_ENABLED=true
