{
  "name": "qadam-ent-mobile",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.23.1"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "type-check": "vue-tsc -b",
    "test": "vitest run",
    "test:function": "vitest run tests/netlify/api.spec.ts",
    "check:functions": "node --check netlify/functions/api.mjs && node --check netlify/functions/lib/qadam-api.mjs",
    "audit": "npm audit --omit=dev --audit-level=high",
    "quality": "npm run audit && npm run format:check && npm run lint && npm run type-check && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@netlify/database": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "lucide-vue-next": "^1.0.0",
    "pg": "^8.23.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.13"
  }
}
