# Local development. Netlify production overrides this to /api via netlify.toml.
VITE_API_BASE_URL=http://localhost:3000

# Release-safe default: learning routes require a verified server session.
VITE_REQUIRE_AUTHENTICATION=true

# Shows the deterministic 111111 code only in the Vite development UI.
VITE_AUTH_DEV_OTP_HINT=true
VITE_AUTH_DEV_OTP_CODE=111111
