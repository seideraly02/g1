# Local development. Netlify production overrides this to /api via netlify.toml.
VITE_API_BASE_URL=http://localhost:3000

# Release-safe default: learning routes require a verified server session.
VITE_REQUIRE_AUTHENTICATION=true

# Netlify Functions security settings. Set the pepper as a secret in Netlify, never in git.
QADAM_SECURITY_PEPPER=replace-with-at-least-32-random-characters
PASSWORD_BCRYPT_STRENGTH=12
SESSION_TTL_DAYS=30

# Netlify injects NETLIFY_DB_URL automatically for deploys and `netlify dev`.
# Never commit a real database connection string.
